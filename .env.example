# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของตัวเอง (ห้าม commit .env ขึ้น git)

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ใช้ Service Role Key (ไม่ใช่ anon key) เพราะ backend ต้องเขียน/อ่านข้ามสิทธิ์ผู้ใช้
# เก็บไว้ในเซิร์ฟเวอร์เท่านั้น ห้ามส่งไปหน้าเว็บ (frontend) เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ใช้เซ็น JWT (token ที่เก็บใน httpOnly cookie) — ตั้งเป็นสตริงยาวๆ สุ่มๆ
# แนะนำให้สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ตั้งเป็น "production" เมื่อ deploy จริง (จะทำให้ cookie ถูกส่งผ่าน HTTPS เท่านั้น)
NODE_ENV=development

PORT=3000
